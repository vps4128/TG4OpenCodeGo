[Unit]
Description=OpenCode Go Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/oc-tg
EnvironmentFile=/opt/oc-tg/.env
ExecStart=/usr/bin/node /opt/oc-tg/dist/index.js
Restart=always
RestartSec=5
User=oc-tg
Group=oc-tg
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
