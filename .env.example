# ===== Telegram =====
# 从 @BotFather 创建机器人后获取
TELEGRAM_BOT_TOKEN=

# 可选：允许使用机器人的 Telegram user id，逗号分隔。
# 留空时，私聊中第一个发送 /start 的用户自动成为 owner。
ALLOWED_USER_IDS=

# ===== OpenCode Go =====
# 在 opencode.ai 控制台 Settings -> API Keys 创建（建议单独创建一个给机器人用）
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai
OPENCODE_USAGE_PATH=/inference/go/v1/usage

# ===== 默认行为 =====
DEFAULT_TZ=Asia/Shanghai
DEFAULT_PUSH_TIMES=09:00
CHECK_INTERVAL_MIN=15
ALERT_THRESHOLDS=50,80,95,100

# ===== 存储与日志 =====
SQLITE_PATH=./data/oc-tg.db
# 可选；默认与 SQLITE_PATH 同目录
# HEALTH_FILE=./data/heartbeat
# TELEGRAM_HEALTH_FILE=./data/telegram-heartbeat
LOG_LEVEL=info
