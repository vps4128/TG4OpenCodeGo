{
  "name": "tg4opencodego",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for querying and pushing OpenCode Go usage",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "healthcheck": "tsx src/healthcheck.ts"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
